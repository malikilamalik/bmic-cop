#MYSQL
MYSQL_ROOT_PASSWORD="hermanmiller"
MYSQL_USER="rules"
MYSQL_PASSWORD="rulesengine"
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_MAX_CONN=50

#COORDINATOR
COORDINATOR_HOST=127.0.0.1
COORDINATOR_PORT=10162
INITIAL_WORKER_ID=0
INITIAL_JOB_ID=0
TASK_TIMEOUT_SECS=7
COORDINATOR_STARTUP_MS=1000

#WORKER
BUF_SIZE=4096
WAIT_TIME_MS=1000
HEARTBEAT_INTERVAL_MS=2000
INITIAL_WORKER_PORT=10163
POLL_JOB_TIMEOUT_MS=250
WORKER_STARTUP_MS=500

#SCHEDULER (crates/pkg/src/config/scheduler.rs)
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 2 * * *
SCHEDULER_TIMEZONE=UTC

#INGESTION (crates/pkg/src/config/ingestion.rs) – gRPC API for crates/ingestion_engine/src/application/client
# Supports both INGESTION_ADDR (e.g. "127.0.0.1:50051") and split HOST/PORT
INGESTION_ADDR=127.0.0.1:50051
INGESTION_HOST=127.0.0.1
INGESTION_PORT=50051

#EVALUATOR (crates/pkg/src/config/evaluator.rs) – gRPC API for crates/core_module/src/application/evaluator
# Supports both EVALUATOR_ADDR and split HOST/PORT
EVALUATOR_ADDR=127.0.0.1:50052
EVALUATOR_HOST=127.0.0.1
EVALUATOR_PORT=50052
